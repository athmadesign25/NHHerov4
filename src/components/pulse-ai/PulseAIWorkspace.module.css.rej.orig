+.healthBanner {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 12px;
+  background: #fffbeb;
+  border: 1px solid #fef3c7;
+  border-radius: 12px;
+  padding: 10px 16px;
+  font-size: 12.5px;
+  font-weight: 600;
+  color: #b45309;
+  margin-bottom: 16px;
+  width: 100%;
+}
+
+.healthBannerClose {
+  background: none;
+  border: none;
+  color: #b45309;
+  cursor: pointer;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  padding: 2px;
+}
+
+.healthFooterActions {
+  grid-column: span 2;
+  display: flex;
+  flex-direction: column;
+  gap: 10px;
+  margin-top: 20px;
+  border-top: 1px solid #e2e8f0;
+  padding-top: 20px;
+}
+
+@media (max-width: 768px) {
+  .healthFooterActions {
+    grid-column: span 1;
+    margin-top: 14px;
+    padding-top: 14px;
+  }
+}
+
+.footerActionsTitle {
+  font-size: 13.5px;
+  font-weight: 700;
+  color: #475569;
+}
+
+.footerActionsRow {
+  display: flex;
+  gap: 10px;
+  flex-wrap: wrap;
+}
+
+.footerActionBtn {
+  padding: 10px 18px;
+  background: #ffffff;
+  border: 1.5px solid #e2e8f0;
+  border-radius: 9999px;
+  color: #034ea2;
+  font-size: 13px;
+  font-weight: 600;
+  cursor: pointer;
+  transition: all 0.2s ease;
+  font-family: inherit;
+}
+
+.footerActionBtn:hover {
+  border-color: #034ea2;
+  background: rgba(3, 78, 162, 0.04);
+  transform: translateY(-1px);
+}
+
+
 
 
 
