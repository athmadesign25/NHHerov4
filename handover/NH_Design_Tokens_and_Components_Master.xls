    <Cell ss:StyleID="RowEven"><Data ss:Type="String">items: [{ src: string, alt: string, caption: string }]</Data></Cell>
    <Cell ss:StyleID="RowEven"><Data ss:Type="String">Single figure highlight, 2-column surgical suite comparison</Data></Cell>
    <Cell ss:StyleID="RowEven"><Data ss:Type="String">Procedure, Disease, Symptom, and Diagnostic detail pages</Data></Cell>
   </Row>
   <Row ss:Height="24">
    <Cell ss:StyleID="RowOdd"><Data ss:Type="String">Nearby Specialists Carousel</Data></Cell>
    <Cell ss:StyleID="CodeStyle"><Data ss:Type="String">&lt;NearbySpecialistsCarousel /&gt;</Data></Cell>
    <Cell ss:StyleID="RowOdd"><Data ss:Type="String">Clinical Consultations</Data></Cell>
    <Cell ss:StyleID="RowOdd"><Data ss:Type="String">src/components/ui/NearbyClinicalCarousels.tsx</Data></Cell>
    <Cell ss:StyleID="RowOdd"><Data ss:Type="String">src/components/ui/NearbyClinicalCarousels.module.css</Data></Cell>
    <Cell ss:StyleID="RowOdd"><Data ss:Type="String">Tokenized (100%)</Data></Cell>
    <Cell ss:StyleID="RowOdd"><Data ss:Type="String">var(--blue-brand), var(--navy-900), var(--radius-xl), var(--radius-md), var(--elevation-1)</Data></Cell>
    <Cell ss:StyleID="RowOdd"><Data ss:Type="String">id?: string, title: string, subtitle: string, doctors: DoctorData[], actionLabel?: string</Data></Cell>
