<?xml version="1.0"?>
<?mso-application progid="Excel.Sheet"?>
<Workbook xmlns="urn:schemas-microsoft-com:office:spreadsheet"
 xmlns:o="urn:schemas-microsoft-com:office:office"
 xmlns:x="urn:schemas-microsoft-com:office:excel"
 xmlns:ss="urn:schemas-microsoft-com:office:spreadsheet"
 xmlns:html="http://www.w3.org/TR/REC-html40">
 <DocumentProperties xmlns="urn:schemas-microsoft-com:office:office">
  <Title>Narayana Health Design Tokens &amp; Components Handover</Title>
  <Author>Narayana Health Design System</Author>
 </DocumentProperties>
 <Styles>
  <Style ss:ID="Default" ss:Name="Normal">
   <Alignment ss:Vertical="Center"/>
   <Borders/>
   <Font ss:FontName="Segoe UI" x:Family="Swiss" ss:Size="10" ss:Color="#1F2937"/>
   <Interior/>
   <NumberFormat/>
   <Protection/>
  </Style>
  <Style ss:ID="HeaderStyle">
   <Alignment ss:Horizontal="Center" ss:Vertical="Center" ss:WrapText="1"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#022D61"/>
    <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#022D61"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#022D61"/>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#022D61"/>
   </Borders>
   <Font ss:FontName="Segoe UI" x:Family="Swiss" ss:Size="10.5" ss:Bold="1" ss:Color="#FFFFFF"/>
   <Interior ss:Color="#034EA2" ss:Pattern="Solid"/>
  </Style>
  <Style ss:ID="RowEven">
   <Alignment ss:Vertical="Center" ss:WrapText="1"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
   </Borders>
   <Interior ss:Color="#F8FAFC" ss:Pattern="Solid"/>
   <Font ss:FontName="Segoe UI" x:Family="Swiss" ss:Size="10" ss:Color="#1E293B"/>
  </Style>
  <Style ss:ID="RowOdd">
   <Alignment ss:Vertical="Center" ss:WrapText="1"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
   </Borders>
   <Interior ss:Color="#FFFFFF" ss:Pattern="Solid"/>
   <Font ss:FontName="Segoe UI" x:Family="Swiss" ss:Size="10" ss:Color="#1E293B"/>
  </Style>
  <Style ss:ID="CodeStyle">
   <Alignment ss:Vertical="Center" ss:WrapText="1"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
   </Borders>
   <Font ss:FontName="Menlo" x:Family="Modern" ss:Size="9.5" ss:Bold="1" ss:Color="#034EA2"/>
   <Interior ss:Color="#EFF6FF" ss:Pattern="Solid"/>
  </Style>
 </Styles>
 <Worksheet ss:Name="Components &amp; Tokens">
  <Table>
   <Column ss:AutoFitWidth="0" ss:Width="180"/>
   <Column ss:AutoFitWidth="0" ss:Width="210"/>
   <Column ss:AutoFitWidth="0" ss:Width="150"/>
   <Column ss:AutoFitWidth="0" ss:Width="270"/>
   <Column ss:AutoFitWidth="0" ss:Width="315"/>
   <Column ss:AutoFitWidth="0" ss:Width="120"/>
   <Column ss:AutoFitWidth="0" ss:Width="330"/>
   <Column ss:AutoFitWidth="0" ss:Width="300"/>
   <Column ss:AutoFitWidth="0" ss:Width="285"/>
   <Column ss:AutoFitWidth="0" ss:Width="285"/>
   <Row ss:Height="28" ss:StyleID="HeaderStyle">
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Simple Name</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Tech Component (JSX)</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Category</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">File Path (TSX)</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">CSS Module Path</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Token Status</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Core Design Tokens Applied</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Key Props &amp; Parameters</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Variant States / Themes</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Mounted On Pages</Data></Cell>
   </Row>
   <Row ss:Height="24">
    <Cell ss:StyleID="RowOdd"><Data ss:Type="String">Breadcrumbs Navigation Trail</Data></Cell>
    <Cell ss:StyleID="CodeStyle"><Data ss:Type="String">&lt;Breadcrumbs /&gt;</Data></Cell>
    <Cell ss:StyleID="RowOdd"><Data ss:Type="String">Navigation</Data></Cell>
    <Cell ss:StyleID="RowOdd"><Data ss:Type="String">src/components/ui/Breadcrumbs.tsx</Data></Cell>
    <Cell ss:StyleID="RowOdd"><Data ss:Type="String">src/components/ui/Breadcrumbs.module.css</Data></Cell>
    <Cell ss:StyleID="RowOdd"><Data ss:Type="String">Tokenized (100%)</Data></Cell>
    <Cell ss:StyleID="RowOdd"><Data ss:Type="String">var(--slate-500), var(--slate-900), var(--blue-brand), var(--font-size-xs), var(--duration-fast)</Data></Cell>
    <Cell ss:StyleID="RowOdd"><Data ss:Type="String">items: [{ label, href }], theme: 'light' | 'dark'</Data></Cell>
    <Cell ss:StyleID="RowOdd"><Data ss:Type="String">Dark scrim header &amp; light page reading modes</Data></Cell>
    <Cell ss:StyleID="RowOdd"><Data ss:Type="String">Treatments, Diseases, Symptoms, Diagnostics, Blog, all Detail pages</Data></Cell>
   </Row>
   <Row ss:Height="24">
    <Cell ss:StyleID="RowEven"><Data ss:Type="String">Animated Gradient Shimmer Heading</Data></Cell>
    <Cell ss:StyleID="CodeStyle"><Data ss:Type="String">&lt;TextSweepEffect /&gt;</Data></Cell>
    <Cell ss:StyleID="RowEven"><Data ss:Type="String">Clinical Editorial</Data></Cell>
    <Cell ss:StyleID="RowEven"><Data ss:Type="String">src/components/ui/TextSweepEffect.tsx</Data></Cell>
    <Cell ss:StyleID="RowEven"><Data ss:Type="String">Inline motion styles + globals.css</Data></Cell>
    <Cell ss:StyleID="RowEven"><Data ss:Type="String">Tokenized (100%)</Data></Cell>
    <Cell ss:StyleID="RowEven"><Data ss:Type="String">var(--blue-brand), var(--color-primary), var(--slate-900), var(--font-size-display), var(--leading-tight)</Data></Cell>
    <Cell ss:StyleID="RowEven"><Data ss:Type="String">words: string[], sweepMs?: number, finalColor?: string</Data></Cell>
    <Cell ss:StyleID="RowEven"><Data ss:Type="String">Infinite shimmer gradient, sweep reveal</Data></Cell>
    <Cell ss:StyleID="RowEven"><Data ss:Type="String">Library pages, Procedure detail (V4), Blog V3 hero</Data></Cell>
   </Row>
   <Row ss:Height="24">
    <Cell ss:StyleID="RowOdd"><Data ss:Type="String">Organ Filter Chips Carousel</Data></Cell>
    <Cell ss:StyleID="CodeStyle"><Data ss:Type="String">&lt;OrganSystemChipsCarousel /&gt;</Data></Cell>
    <Cell ss:StyleID="RowOdd"><Data ss:Type="String">Navigation &amp; Filtering</Data></Cell>
    <Cell ss:StyleID="RowOdd"><Data ss:Type="String">src/components/ui/OrganSystemChipsCarousel.tsx</Data></Cell>
    <Cell ss:StyleID="RowOdd"><Data ss:Type="String">src/components/ui/OrganSystemChipsCarousel.module.css</Data></Cell>
    <Cell ss:StyleID="RowOdd"><Data ss:Type="String">Tokenized (100%)</Data></Cell>
    <Cell ss:StyleID="RowOdd"><Data ss:Type="String">var(--blue-brand), var(--slate-700), var(--slate-900), var(--radius-full), var(--duration-base)</Data></Cell>
    <Cell ss:StyleID="RowOdd"><Data ss:Type="String">items: OrganItem[], activeId: string, onSelect: (id) =&gt; void, showAllOption: boolean</Data></Cell>
    <Cell ss:StyleID="RowOdd"><Data ss:Type="String">Active pill (brand blue + glow), Inactive pill (soft slate outline)</Data></Cell>
    <Cell ss:StyleID="RowOdd"><Data ss:Type="String">Treatments, Diseases, Symptoms, Diagnostics libraries</Data></Cell>
   </Row>
   <Row ss:Height="24">
    <Cell ss:StyleID="RowEven"><Data ss:Type="String">Clinical Executive Summary Banner</Data></Cell>
    <Cell ss:StyleID="CodeStyle"><Data ss:Type="String">&lt;ClinicalSummaryBanner /&gt;</Data></Cell>
    <Cell ss:StyleID="RowEven"><Data ss:Type="String">Clinical Editorial</Data></Cell>
    <Cell ss:StyleID="RowEven"><Data ss:Type="String">src/components/ui/ClinicalReviewedBySection.tsx</Data></Cell>
    <Cell ss:StyleID="RowEven"><Data ss:Type="String">src/components/ui/ClinicalReviewedBySection.module.css</Data></Cell>
    <Cell ss:StyleID="RowEven"><Data ss:Type="String">Tokenized (100%)</Data></Cell>
    <Cell ss:StyleID="RowEven"><Data ss:Type="String">var(--summary-bg), var(--summary-text), var(--summary-accent), var(--summary-border), var(--radius-lg)</Data></Cell>
    <Cell ss:StyleID="RowEven"><Data ss:Type="String">eyebrow?: string, summary: string, reviewerName?: string, reviewAnchorId?: string</Data></Cell>
    <Cell ss:StyleID="RowEven"><Data ss:Type="String">V1 elevated curved sheet (charcoal text), V2 scroll blend, V4 text sweep blend</Data></Cell>
    <Cell ss:StyleID="RowEven"><Data ss:Type="String">Procedure, Disease, Symptom, Diagnostic, and Article detail pages</Data></Cell>
   </Row>
   <Row ss:Height="24">
    <Cell ss:StyleID="RowOdd"><Data ss:Type="String">Google E-E-A-T 'Reviewed By' Card</Data></Cell>
    <Cell ss:StyleID="CodeStyle"><Data ss:Type="String">&lt;ClinicalReviewedBySection /&gt;</Data></Cell>
