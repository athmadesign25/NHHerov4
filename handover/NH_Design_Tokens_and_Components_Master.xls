    <Cell ss:StyleID="RowOdd"><Data ss:Type="String">doctorName, doctorRole, speciality, hospital, experience, doctorImage, reviewDate, id</Data></Cell>
    <Cell ss:StyleID="RowOdd"><Data ss:Type="String">Full credential trust card with NABL/NABH badges and bio links</Data></Cell>
    <Cell ss:StyleID="RowOdd"><Data ss:Type="String">Procedure, Disease, Symptom, Diagnostic, and Article detail pages</Data></Cell>
   </Row>
   <Row ss:Height="24">
