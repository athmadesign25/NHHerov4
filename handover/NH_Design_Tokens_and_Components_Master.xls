    <Cell ss:StyleID="CodeStyle"><Data ss:Type="String">&lt;ClinicalEditorialFigures /&gt;</Data></Cell>
    <Cell ss:StyleID="RowEven"><Data ss:Type="String">Media &amp; Clinical Content</Data></Cell>
